# Copy to .env in repository root. Never commit .env.
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_PORT=5544
DATABASE_URL=postgresql://wawatube:replace-with-long-random-password@127.0.0.1:5544/wawatube
TA_USERNAME=wawatube
TA_PASSWORD=replace-with-a-different-long-random-password
ELASTIC_PASSWORD=replace-with-another-long-random-password
TA_PORT=18000
# Compose bind mount: relative to docker/docker-compose.yml.
TA_MEDIA_ROOT=../data/youtube
MEDIA_UID=1000
MEDIA_GID=1000
TZ=America/Managua
TUBE_ARCHIVIST_URL=http://127.0.0.1:18000
# Copy token from Tube Archivist settings after first startup.
TUBE_ARCHIVIST_TOKEN=
# API resolves relative roots from repository root, regardless of cwd.
LOCAL_MEDIA_ROOT=./media/local
FFPROBE_PATH=ffprobe
HOST=0.0.0.0
PORT=3100
# Set to the exact address used by the browser (LAN IP for phone/tablet).
PUBLIC_ORIGIN=http://localhost:3100
SESSION_HOURS=8
SECURE_COOKIES=false
